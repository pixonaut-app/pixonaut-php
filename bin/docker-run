#!/usr/bin/env bash
# Runs a command in the package's PHP image with the checkout mounted at /app,
# so the host needs Docker and nothing else. PHP_VERSION picks the image's
# php:<version>-cli base (default 8.1, the package's minimum).
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
php_version="${PHP_VERSION:-8.1}"
image="pixonaut-php-dev:${php_version}"

docker build --quiet \
    --build-arg "PHP_VERSION=${php_version}" \
    --tag "${image}" \
    "${root}/docker/php" >/dev/null

# Rootless Docker already maps the container's root to the host user; a
# rootful daemon needs the host uid, or the files written to the checkout
# end up owned by root.
user_args=()
if ! docker info --format '{{.SecurityOptions}}' 2>/dev/null | grep -q rootless; then
    user_args=(--user "$(id -u):$(id -g)")
fi

# Standard input is always passed through, so `bin/php < script.php` works;
# a TTY only when there is a terminal on both ends.
tty_args=()
if [ -t 0 ] && [ -t 1 ]; then
    tty_args=(--tty)
fi

# DOCKER_NETWORK picks the container's network: `none` leaves it loopback
# only, `host` lets it reach a server on the host's loopback.
network_args=()
if [ -n "${DOCKER_NETWORK:-}" ]; then
    network_args=(--network "${DOCKER_NETWORK}")
fi

# The live smoke's target, passed through only when set.
live_args=()
for name in PIXONAUT_LIVE_API_URL PIXONAUT_LIVE_SECRET_KEY PIXONAUT_LIVE_INTEGRATION_KEY; do
    if [ -n "${!name:-}" ]; then
        live_args+=(--env "${name}")
    fi
done

exec docker run --rm --interactive \
    "${user_args[@]}" \
    "${tty_args[@]}" \
    "${network_args[@]}" \
    "${live_args[@]}" \
    --volume "${root}:/app" \
    --workdir /app \
    --env HOME=/tmp \
    --env COMPOSER_HOME=/tmp/composer \
    --env COMPOSER_CACHE_DIR=/app/.cache/composer \
    --env COMPOSER_ROOT_VERSION="${COMPOSER_ROOT_VERSION:-dev-main}" \
    "${image}" \
    "$@"
