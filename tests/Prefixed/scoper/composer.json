{
    "name": "pixonaut/prefixed-with-php-scoper",
    "description": "An integration that prefixes the SDK and its dependencies with PHP-Scoper.",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "package",
            "options": {
                "symlink": false,
                "versions": {
                    "pixonaut/pixonaut-php": "1.0.0"
                }
            }
        }
    ],
    "require": {
        "pixonaut/pixonaut-php": "1.0.0",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "symfony/http-client": "^6.4 || ^7.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}
