<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         defaultTestSuite="unit,contract"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         failOnDeprecation="true"
         failOnNotice="true"
         beStrictAboutOutputDuringTests="true">
    <php>
        <!-- The pinned spec, decoded, and the generator's model of it. -->
        <ini name="memory_limit" value="2G"/>
    </php>
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Guard</directory>
            <directory>tests/Spec</directory>
            <directory>tests/Unit</directory>
            <directory>tests/Generator</directory>
        </testsuite>
        <testsuite name="contract">
            <directory>tests/Contract</directory>
        </testsuite>
        <!-- Only through `composer test:live`, against a Pixonaut on this machine. -->
        <testsuite name="live">
            <directory>tests/Live</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
