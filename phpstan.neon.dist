parameters:
    level: max
    parallel:
        # Each worker analyses part of the ~4,000 generated classes, within
        # the memory limit `composer analyse` gives it.
        maximumNumberOfProcesses: 4
    paths:
        - src
        - generator
        - tests
        - docs/examples
    excludePaths:
        # Deliberately bad code the guard test is run against.
        - tests/Guard/fixtures
        # Classes the surface test reads, not code that runs.
        - tests/Generator/Surface/Fixtures
        # PHP-Scoper's configuration, read by the tool with its own classes.
        - tests/Prefixed/scoper/scoper.inc.php
